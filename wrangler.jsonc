/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stape-mcp-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "migrations": [
    {
      "new_sqlite_classes": [
        "StapeMCPServer"
      ],
      "tag": "v1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "StapeMCPServer",
        "name": "MCP_OBJECT"
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "mcp.stape.ai",
      "custom_domain": true
    }
  ],
  "env": {
    "dev": {
      "name": "stape-mcp-server-dev",
      "durable_objects": {
        "bindings": [
          {
            "class_name": "StapeMCPServer",
            "name": "MCP_OBJECT"
          }
        ]
      },
      "routes": [
        {
          "pattern": "mcp.stape.dev",
          "custom_domain": true
        }
      ]
    },
    "sh": {
      "name": "stape-mcp-server-sh",
      "durable_objects": {
        "bindings": [
          {
            "class_name": "StapeMCPServer",
            "name": "MCP_OBJECT"
          }
        ]
      },
      "routes": [
        {
          "pattern": "mcp.stape.sh",
          "custom_domain": true
        }
      ]
    },
    "qa": {
      "name": "stape-mcp-server-qa",
      "durable_objects": {
        "bindings": [
          {
            "class_name": "StapeMCPServer",
            "name": "MCP_OBJECT"
          }
        ]
      },
      "routes": [
        {
          "pattern": "mcp.stape.qa",
          "custom_domain": true
        }
      ]
    },
    "re": {
      "name": "stape-mcp-server-re",
      "durable_objects": {
        "bindings": [
          {
            "class_name": "StapeMCPServer",
            "name": "MCP_OBJECT"
          }
        ]
      },
      "routes": [
        {
          "pattern": "mcp.stape.re",
          "custom_domain": true
        }
      ]
    }
  }
}
